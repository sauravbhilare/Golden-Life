            <div class="modal fade" id="ChangePassword" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Change Password</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="ddlCategory">Old Password</label><span style="color: red">*</span>
                                        <asp:TextBox ID="txtOldPssword" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ID="RequiredFieldValidator1" runat="server" ValidationGroup="Password" ErrorMessage="Old Password is Required" ControlToValidate="txtOldPssword" Display="None"></asp:RequiredFieldValidator>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="ddlCategory">New Password</label><span style="color: red">*</span>
                                        <asp:TextBox ID="txtNewPassword" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ID="RequiredFieldValidator2" runat="server" ValidationGroup="Password" ErrorMessage="New Password is Required" ControlToValidate="txtNewPassword" Display="None"></asp:RequiredFieldValidator>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="ddlCategory">Confirm Password</label><span style="color: red">*</span>
                                        <asp:TextBox ID="txtConfirmPassword" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ID="RequiredFieldValidator3" runat="server" ValidationGroup="Password" ErrorMessage="Confirm Password is Required" ControlToValidate="txtConfirmPassword" Display="None"></asp:RequiredFieldValidator>
                                        <asp:CompareValidator ID="CompareValidator1" EnableClientScript="True" runat="server" ErrorMessage="Old Password and New Password Must be Same" ControlToCompare="txtNewPassword" Display="None" ControlToValidate="txtConfirmPassword" ValidationGroup="Password"></asp:CompareValidator>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <asp:LinkButton ID="lbrnChane" runat="server" class="btn btn-primary" ValidationGroup="Password" OnClick="lbrnChane_Click">Change Password</asp:LinkButton>
                            <asp:ValidationSummary ID="ValidationSummary1" runat="server" ValidationGroup="Password" ShowMessageBox="True" ShowSummary="False" />
                        </div>
                    </div>
                </div>
